# Trade-in Widget - Shared Environment Variables

# API Backend
TRADEIN_API_URL=http://localhost:8000
TRADEIN_ADMIN_TOKEN=your_admin_token_here

# ==================== SHOPIFY ====================
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_SCOPES=write_discounts,read_products,write_products
SHOPIFY_APP_URL=https://your-shopify-app.com
SHOPIFY_SESSION_SECRET=generate_random_32_char_secret
TRADEIN_SERVICE_TOKEN=shared_service_token_between_apis

# ==================== NUVEMSHOP ====================
NUVEMSHOP_APP_ID=your_nuvemshop_app_id
NUVEMSHOP_APP_SECRET=your_nuvemshop_app_secret
NUVEMSHOP_REDIRECT_URI=https://your-nuvemshop-integration.com/auth/callback
TRADEIN_WIDGET_CDN_URL=https://your-tradein-api.com

# ==================== WOOCOMMERCE ====================
# Configurado via painel WordPress

# ==================== GERAL ====================
NODE_ENV=production
