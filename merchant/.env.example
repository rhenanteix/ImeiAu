DATABASE_URL=postgresql://tradein:tradein@localhost:5432/tradein_merchant
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SEED_EMAIL=lojista@example.com
SEED_PASSWORD=replace-with-a-strong-local-password
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# mock keeps every integration local; webhook forwards events to your integration gateway.
INTEGRATION_MODE=mock
# INTEGRATION_WEBHOOK_URL=https://your-gateway.example.com/events
# INTEGRATION_WEBHOOK_SECRET=replace-with-a-signing-secret

# IMEI.info: server-only credentials from https://dash.imei.info/
# Choose a service that returns a blacklist result (not just model/TAC data).
IMEI_INFO_API_KEY=
IMEI_INFO_SERVICE_ID=
# Field path inside provider's result object. Only CLEAN / BLACKLISTED are accepted.
IMEI_INFO_STATUS_FIELD=blacklist_status

# Contact form: authenticated SMTP. No real email is sent without these values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=contato@ribeiraconnect.com.br
# Fixed recipients in server code: contato@ribeiraconnect.com.br, rhenancontato@gmail.com
