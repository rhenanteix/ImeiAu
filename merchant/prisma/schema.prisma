generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum OperationMode {
  instant_coupon
  post_inspection
}
enum FreightPayer {
  store
  customer
}
enum TradeStatus {
  pending_shipping
  shipped
  inspecting
  counteroffered
  approved
  rejected
  sent_to_buyer
  completed
}
enum B2BBuyerStatus {
  pending_kyc
  approved
  rejected
  suspended
}
enum B2BOfferStatus {
  active
  inactive
  expired
}
enum B2BLotStatus {
  open
  closed
  settled
}
enum B2BSplitStatus {
  pending
  paid
  split_completed
  failed
  refunded
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  memberships Membership[]
  b2bBuyer B2BBuyer?
}
model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model RateLimit {
  id String @id @default(cuid())
  key String @unique
  count Int
  lastRequest BigInt
}
model Membership {
  id String @id @default(cuid())
  userId String
  storeId String
  role String @default("owner")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@unique([userId, storeId])
}
model Store {
  id String @id @default(cuid())
  name String
  domain String @unique
  platform String
  mode OperationMode @default(post_inspection)
  freightPayer FreightPayer @default(store)
  freightCents Int @default(2500)
  marginBps Int @default(1000)
  payoutMethod String @default("coupon")
  version Int @default(0)
  memberships Membership[]
  devices Device[]
  rules ConditionRule[]
  requests TradeIn[]
  events OutboxEvent[]
  updatedAt DateTime @updatedAt
}
model Device {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  brand String
  model String
  storage String
  basePriceCents Int
  active Boolean @default(true)
  version Int @default(0)
  requests TradeIn[]
  @@unique([storeId, brand, model, storage])
  @@unique([storeId, id])
}
model ConditionRule {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  criteria String
  label String
  deductionBps Int
  version Int @default(0)
  @@unique([storeId, criteria])
}
model TradeIn {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id])
  deviceId String
  device Device @relation(fields: [storeId, deviceId], references: [storeId, id])
  customer Json
  condition Json
  pricingSnapshot Json
  estimatedCents Int
  finalCents Int?
  mode OperationMode
  payoutMethod String
  status TradeStatus @default(pending_shipping)
  version Int @default(0)
  couponCode String?
  shippingCode String
  returnShippingCode String?
  returnLabelUrl String?
  trackingCode String?
  carrier String?
  payoutReference String?
  preauthorizationRef String?
  preauthorizationStatus String?
  imei String?
  imeiChecked Boolean @default(false)
  imeiBlocked Boolean @default(false)
  imeiCheckResult Json?
  photos Json?
  logisticsProvider String?
  reverseAuthorizationCode String?
  reverseLabelUrl String?
  webhookLastEvent Json?
  idempotencyKey String
  payloadHash String
  consentAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  inspections Inspection[]
  counteroffers Counteroffer[]
  events OutboxEvent[]
  lotId String?
  lot B2BLot? @relation(fields: [lotId], references: [id])
  b2bBuyerId String?
  b2bBuyer B2BBuyer? @relation(fields: [b2bBuyerId], references: [id])
  b2bOfferId String?
  b2bOffer B2BOffer? @relation(fields: [b2bOfferId], references: [id])
  matchedAt DateTime?
  sentToBuyerAt DateTime?
  @@unique([storeId, idempotencyKey])
  @@index([storeId, status, createdAt])
  @@index([lotId])
}
model Inspection {
  id String @id @default(cuid())
  tradeInId String
  tradeIn TradeIn @relation(fields: [tradeInId], references: [id])
  actorId String
  powersOn Boolean
  imeiMatches Boolean
  conditionMatches Boolean
  notes String
  decision String
  createdAt DateTime @default(now())
}
model Counteroffer {
  id String @id @default(cuid())
  tradeInId String
  tradeIn TradeIn @relation(fields: [tradeInId], references: [id])
  amountCents Int
  reason String
  tokenHash String @unique
  expiresAt DateTime
  respondedAt DateTime?
  accepted Boolean?
  createdAt DateTime @default(now())
}
model OutboxEvent {
  id String @id @default(cuid())
  storeId String
  store Store @relation(fields: [storeId], references: [id])
  tradeInId String
  tradeIn TradeIn @relation(fields: [tradeInId], references: [id])
  type String
  payload Json
  status String @default("pending")
  attempts Int @default(0)
  lastError String?
  availableAt DateTime @default(now())
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  @@index([status, availableAt])
}
model Lead {
  id String @id @default(cuid())
  email String @unique
  data Json
  createdAt DateTime @default(now())
}

model B2BBuyer {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  cnpj String? @unique
  contactName String
  contactPhone String
  address Json?
  status B2BBuyerStatus @default(pending_kyc)
  kycData Json?
  approvedAt DateTime?
  approvedBy String?
  notes String?
  commissionRateBps Int @default(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  offers B2BOffer[]
  lots B2BLot[]
  tradeIns TradeIn[]
  splitTransactions B2BSplitTransaction[]
  @@index([status])
}

model B2BOffer {
  id String @id @default(cuid())
  buyerId String
  buyer B2BBuyer @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  brand String
  model String
  storage String?
  conditionCriteria Json
  maxPriceCents Int
  minQuantity Int @default(1)
  status B2BOfferStatus @default(active)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tradeIns TradeIn[]
  @@index([buyerId, status])
  @@index([brand, model])
}

model B2BLot {
  id String @id @default(cuid())
  buyerId String?
  buyer B2BBuyer? @relation(fields: [buyerId], references: [id])
  status B2BLotStatus @default(open)
  totalDevices Int @default(0)
  totalValueCents Int @default(0)
  settledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tradeIns TradeIn[]
  splitTransaction B2BSplitTransaction?
  @@index([status])
}

model B2BSplitTransaction {
  id String @id @default(cuid())
  lotId String @unique
  lot B2BLot @relation(fields: [lotId], references: [id])
  buyerId String
  buyer B2BBuyer @relation(fields: [buyerId], references: [id])
  paymentProvider String
  paymentIntentId String?
  chargeId String?
  buyerPaidCents Int
  commissionCents Int
  merchantPayoutCents Int
  commissionRateBps Int
  status B2BSplitStatus @default(pending)
  splitConfig Json?
  webhookData Json?
  paidAt DateTime?
  splitCompletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status])
  @@index([buyerId])
}

model ImeiLookup {
  id String @id
  historyId String?
  result Json?
  expiresAt DateTime
  lockedUntil DateTime
  updatedAt DateTime @updatedAt
}

model ContactRequest {
  id String @id
  payloadHash String
  data Json
  acceptedRecipients String[] @default([])
  sentAt DateTime?
  lockedUntil DateTime
  createdAt DateTime @default(now())
}
